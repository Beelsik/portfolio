# Скопируйте этот файл в .env и выберите провайдера.
# Если .env не создавать или оставить LLM_API_KEY пустым — стенды работают на локальном движке.

PORT=3000

# --- Вариант 1: NVIDIA NIM (https://build.nvidia.com, бесплатный старт, OpenAI-совместимый) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Вариант 2: OpenAI / OpenRouter / DeepSeek / Groq ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Вариант 3: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-haiku-latest

# --- Вариант 4: Google Gemini ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash

# --- Вариант 5: Локальная Ollama на вашем ПК ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b

# Лимит запросов с одного IP за 10 минут (защита ключа при публичной ссылке)
RATE_LIMIT_MAX=40
