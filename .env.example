# Скопируйте этот файл в .env и заполните нужные ключи.

PORT=3000

# === УРОВЕНЬ 1: БЫСТРЫЙ КОНТУР (Чаты, RAG, маркетплейсы, быстрый Vision OCR) ===
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# === УРОВЕНЬ 2: ТЯЖЁЛЫЙ КОНТУР — GOOGLE CLOUD VERTEX AI (Разбор ТЗ, Аудит кода, Документы, Red-Team) ===
# Можно указать ЛИБО ключ Vertex AI Express Mode (VERTEX_API_KEY),
# ЛИБО вставить однострочный JSON сервисного аккаунта Google Cloud в VERTEX_CREDENTIALS_JSON.
# Если не заполнено или исчерпан дневной лимит — сервер автоматически уходит на Уровень 1 без ошибок!
VERTEX_MODEL=gemini-2.5-pro
VERTEX_LOCATION=us-central1
VERTEX_API_KEY=
VERTEX_CREDENTIALS_JSON=

# === ФИНАНСОВЫЙ ПРЕДОХРАНИТЕЛЬ (Cost & Abuse Firewall) ===
DAILY_BUDGET_USD=1.50
HEAVY_IP_LIMIT=10
RATE_LIMIT_MAX=80
